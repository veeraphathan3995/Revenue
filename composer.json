{
  "name": "cmu-polsci/revenue-estimation-laravel",
  "type": "project",
  "description": "ระบบประมาณการรายรับเงินรายได้ คณะรัฐศาสตร์และรัฐประศาสนศาสตร์ มหาวิทยาลัยเชียงใหม่ (Laravel 13 + MySQL 8.x + Blade + Vue 3 Non-SFC)",
  "keywords": ["laravel", "revenue-estimation", "cmu", "mysql", "vue-cdn-non-sfc"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-bcmath": "*",
    "ext-pdo": "*",
    "laravel/framework": "^13.0 || ^12.0 || ^11.0",
    "phpoffice/phpspreadsheet": "^2.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
